{
  "name": "fortuna-real",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "scripts": {
    "crear-instalador": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./crear-instalador.ps1",
    "publicar-actualizacion": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./crear-instalador.ps1 -Publish",
    "fortuna": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./iniciar-fortuna.ps1",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "test": "npm run test:types && npm run test:persistence && npm run test:updater && npm run test:release-config && npm run test:capacity && npm run test:marble-seeds && npm run test:ducks && npm run test:fairness && npm run test:recovery && npm run test:audio && npm run test:screens && npm run test:accessibility && npm run test:tutorials",
    "test:types": "tsc --noEmit -p tsconfig.tests.json",
    "test:persistence": "node --experimental-strip-types ./scripts/persistence-check.ts",
    "test:updater": "node --experimental-strip-types ./scripts/updater-check.ts",
    "test:release-config": "node --experimental-strip-types ./scripts/release-config-check.ts && node ./scripts/dependency-fingerprint.mjs --self-test",
    "test:capacity": "node --experimental-strip-types ./scripts/capacity-check.ts",
    "test:marble-seeds": "node --experimental-strip-types ./scripts/marble-seed-check.ts",
    "test:ducks": "node --experimental-strip-types ./scripts/duck-wave-check.ts && node --experimental-strip-types ./scripts/duck-game-check.ts",
    "test:fairness": "node --experimental-strip-types ./scripts/fairness-commitment-check.ts",
    "test:recovery": "node --experimental-strip-types ./scripts/recoverable-round-check.ts",
    "test:audio": "node --experimental-strip-types ./scripts/audio-engine-check.ts",
    "test:screens": "node --experimental-strip-types ./scripts/screen-integration-check.ts",
    "test:accessibility": "node --experimental-strip-types ./scripts/accessibility-check.ts",
    "test:tutorials": "node --experimental-strip-types ./scripts/tutorial-check.ts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^1.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
